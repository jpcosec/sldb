{
  "project_identity": "sldb",
  "integrate": {
    "remote_url": "https://github.com/jpcosec/sldb.git",
    "branch": "main",
    "suite": [
      "sh",
      "-c",
      "/mnt/ssd/proyectos/SLDB_1/.venv/bin/python -m pytest -q -n 4 -p no:cacheprovider && PYTHONPATH=src /mnt/ssd/proyectos/SLDB_1/.venv/bin/sldb selfdoc check"
    ],
    "suite_timeout": 5400,
    "tests_lock": "/dev/shm/sldb1-tests.lock",
    "tools_checkout": "/mnt/ssd/herramientas/sldb",
    "push_env": {
      "GIT_TERMINAL_PROMPT": "0",
      "GIT_CONFIG_COUNT": "3",
      "GIT_CONFIG_KEY_0": "credential.helper",
      "GIT_CONFIG_VALUE_0": "",
      "GIT_CONFIG_KEY_1": "credential.helper",
      "GIT_CONFIG_VALUE_1": "!f(){ echo username=jpcosec; echo \"password=$(gh auth token -u jpcosec)\"; }; f",
      "GIT_CONFIG_KEY_2": "credential.https://github.com.username",
      "GIT_CONFIG_VALUE_2": "jpcosec"
    }
  },
  "queue_jobs": {
    "integrate": {
      "run": [
        "deskops",
        "integrate",
        "--task-from-env",
        "--root",
        "."
      ],
      "timeout": 7200
    }
  },
  "queue_min_available_gb": 8,
  "queue_max_psi_avg60": 10,
  "versions": {
    "desk_format": "1.0.0",
    "model_version": "1.0.0"
  },
  "sandbox": {
    "enabled": false,
    "sandbox_root": ".tmp/deskops-sandbox"
  }
}
