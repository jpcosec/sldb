"""Borde: create_document a un directorio anidado inexistente con actor, y rechazo sin crear padres."""
import re, sys, tempfile, importlib.util
from pathlib import Path
spec = importlib.util.spec_from_file_location("tda", sys.argv[1]); tda = importlib.util.module_from_spec(spec); spec.loader.exec_module(tda)
from sldb import api
import sldb; print("sldb from", Path(sldb.__file__).parent.parent)
base = Path(tempfile.mkdtemp(dir="/dev/shm"))
(base / f"{tda.MODULE}.py").write_text(tda.MODELS, encoding="utf-8"); sys.path.insert(0, str(base))
w = tda.World(base)
ref = api.create_document(w.store, "Review", w.root / "deep/x/y/r.md", {"title": "r", "subject": "doc:TaskDoc:b", "verdict": "accepted"}, "r", w.py, actor="tester")
text = ref.path.read_text()
print("REF", ref.model, ref.name, ref.path.relative_to(w.root))
print(re.sub(r"\d{4}-\d\d-\d\dT[\d:.]+Z?", "<TS>", text))
print("tracked:", sorted(d.name for d in api.list_documents(w.store, "Review")) if hasattr(api, "list_documents") else "n/a")
try:
    api.create_document(w.store, "Review", w.root / "refused/dir/z.md", {"title": "z", "subject": "not an anchor", "verdict": ""}, "z", w.py)
    print("NOT REFUSED")
except Exception as e:
    print("refused:", type(e).__name__)
print("parent created after refusal:", (w.root / "refused").exists())
