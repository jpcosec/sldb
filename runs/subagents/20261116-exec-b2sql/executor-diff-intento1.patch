+@needs_sql
+def test_sql_repeated_objects_take_a_suffix_and_unparsed_statements_give_nothing(tmp_path):
+    from sldb.code.scan import scan_tree
+
+    (tmp_path / "m.sql").write_text("CREATE TABLE t (a int);\nCREATE TABLE t (a int, b int);\nCREATE TABLE bad (a int, CONSTRAINT k UNIQUE (a));\n"
+                                    "CREATE INDEX i ON t (a);\nCREATE INDEX i ON t (b);\n", encoding="utf-8")
+    facts = {f["id"]: f for f in scan_tree(tmp_path)}
+    assert sorted(facts) == ["m", "m.i", "m.i~2", "m.t", "m.t.a", "m.t~2", "m.t~2.a", "m.t~2.b"], "no fact of `bad`, not even its columns"
+    assert (facts["m.t~2"]["qualified_name"], facts["m.t~2.b"]["qualified_name"], facts["m.i~2"]["qualified_name"]) == ("t~2", "t~2.b", "i~2")
