index 00000000..c20fb7f2
--- /dev/null
+++ b/src/sldb/code/sql_fingerprints.py
@@ -0,0 +1,21 @@
+"""The four fingerprints of a SQL object, over the same hashing and token walk as Python's
+(`fingerprints.py`, normalization 1): `signature` is the whole `CREATE` statement (or column
+definition), whitespace collapsed; `shape` the same with the name taken out; `docstring` the `--`
+comment; `body` the leaf tokens after the name, without comments. The module's signature is
+`module` and its body is the whole file.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from sldb.code.fingerprints import _sha, _tokens
+from sldb.code.sql_readers import sql_norm
+
+
+def sql_fingerprints(node: Any, name: Any, doc: str | None, src: bytes) -> dict[str, str | None]:
+    signature = sql_norm(node, src) if name is not None else "module"
+    shape = signature.replace(sql_norm(name, src), "_", 1) if name is not None else signature
+    after = [c for c in node.children if name is None or c.start_byte >= name.end_byte]
+    body = [t for c in after for t in _tokens(c, src, None)]
+    return {"signature": _sha(signature), "shape": _sha(shape), "docstring": _sha(doc) if doc is not None else None, "body": _sha(" ".join(body))}
diff --git a/src/sldb/code/sql_readers.py b/src/sldb/code/sql_readers.py
new file mode 100644
index 00000000..1dfecb43
--- /dev/null
+++ b/src/sldb/code/sql_readers.py
@@ -0,0 +1,54 @@
+"""Readers over tree-sitter-sql nodes (PostgreSQL DDL): the `CREATE` statements, their names, columns and `--` comments.
+
+A statement counts only when tree-sitter-sql parses it without error; one it does not recognize
+gives no fact at all. `CREATE TABLE`, `CREATE VIEW`, `CREATE MATERIALIZED VIEW` and `CREATE INDEX`
+are read; the name keeps its schema when written (`public.users`). A table's columns are its
+`column_definition`s; table constraints (`PRIMARY KEY (...)`, `FOREIGN KEY`, `UNIQUE` at the end) are not columns.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from sldb.code.readers import text
+
+KINDS = {"create_table": "table", "create_view": "view", "create_materialized_view": "view", "create_index": "index"}
+_NAMES = {"create_index": "identifier"}
+
+
+def creations(root: Any) -> list[tuple[Any, Any, Any]]:
+    """`(statement, create node, name node)` of each clean top-level `CREATE` the grammar recognizes, in source order."""
+    out = []
+    for stmt in root.named_children:
+        if stmt.type != "statement" or stmt.has_error:
+            continue
+        for node in (n for n in stmt.named_children if n.type in KINDS):
+            name = next((c for c in node.named_children if c.type == _NAMES.get(node.type, "object_reference")), None)
+            out += [(stmt, node, name)] if name is not None else []
+    return out
+
+
+def columns(node: Any) -> list[tuple[Any, Any]]:
+    """`(column_definition, name node)` of a `CREATE TABLE`, in order."""
+    defs = next((c for c in node.named_children if c.type == "column_definitions"), None)
+    kids = defs.named_children if defs is not None else []
+    return [(c, c.child_by_field_name("name")) for c in kids if c.type == "column_definition" and c.child_by_field_name("name") is not None]
+
+
+def sql_doc(stmt: Any, src: bytes) -> str | None:
+    """The `--` lines right above `stmt`, contiguous and each on its own line, joined by newlines without `--`."""
+    lines, cur, row = [], stmt.prev_sibling, stmt.start_point[0]
+    while cur is not None and cur.type == "comment" and text(cur, src).startswith("--") and cur.end_point[0] + 1 == row and _own_line(cur):
+        lines.insert(0, text(cur, src)[2:].strip())
+        row, cur = cur.start_point[0], cur.prev_sibling
+    return "\n".join(lines).strip() or None
+
+
+def _own_line(comment: Any) -> bool:
+    prev = comment.prev_sibling
+    return prev is None or prev.end_point[0] < comment.start_point[0]
+
+
+def sql_norm(node: Any, src: bytes) -> str:
+    """The node's text with whitespace collapsed (no requoting: in SQL `"x"` is an identifier)."""
+    return " ".join(text(node, src).split())
