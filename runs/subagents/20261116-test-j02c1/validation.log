"""Edge: guarded error class identity for every catcher, plus CLI end-to-end message."""
import sys, tempfile, io, contextlib
from pathlib import Path
import sldb.core.exceptions as core
import sldb.store.exceptions as storeexc
from sldb.core.exceptions.store_error import StoreError
from sldb.store.io import derived_guard as g, load_store_index, invalidate_index_cache
from sldb.cli.main import main as cli_main

assert storeexc.SLDBStoreError is core.SLDBStoreError, "seam reexport is a different class"
assert g.SLDBStoreError is core.SLDBStoreError
e = g.unmerged_index_error(Path("x.yaml"))
for cls in (core.SLDBStoreError, core.SLDBError, StoreError):
    assert isinstance(e, cls), cls
print("class identity OK; MRO:", [c.__module__ + '.' + c.__name__ for c in type(e).__mro__])

d = Path(tempfile.mkdtemp(dir="/dev/shm"))
assert cli_main(["stores", "init", "--path", str(d)]) == 0
idx = d / ".sldb" / "core" / "store_index.yaml"
assert idx.is_file(), idx
idx.write_text("<<<<<<< HEAD\nstore_hash: a\n||||||| base\nstore_hash: o\n=======\nstore_hash: b\n>>>>>>> other\n")
invalidate_index_cache()
expected = f"{idx} is a derived index that git could not merge: run `sldb stores rebuild-index` (and `sldb stores merge-driver --install` once per clone)"
# catch as core class (how derived_recovery / CLI main catch)
try:
    load_store_index(d / ".sldb"); raise SystemExit("no error raised")
except core.SLDBError as exc:
    assert str(exc) == expected, str(exc)
    print("api catch via core.SLDBError OK")
# CLI end to end: main turns SLDBError into SystemExit(str)
for argv in (["stores", "check", "--store", str(d / ".sldb")], ["docs", "list", "--store", str(d / ".sldb")]):
    invalidate_index_cache()
    err = io.StringIO()
    try:
        with contextlib.redirect_stderr(err):
            rc = cli_main(argv)
        print(argv[:2], "rc", rc, "stderr:", err.getvalue()[-300:])
    except SystemExit as se:
        print(argv[:2], "SystemExit:", se.code)
        assert "sldb stores rebuild-index" in str(se.code)
