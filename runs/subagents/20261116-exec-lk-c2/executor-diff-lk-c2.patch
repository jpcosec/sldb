--- /dev/null
+++ b/src/sldb/links/code_mask.py
@@ -0,0 +1,33 @@
+"""Blank the code of a Markdown text so the link scan does not read it.
+
+CommonMark rules: fenced and indented code blocks come from `code_blocks.mask_blocks`; an
+inline code span opens with a run of N backticks not escaped by `\\` and closes with the next
+run of exactly N in the same paragraph. `\\r\\n` line ends count like `\\n`. Code is replaced
+by spaces (newlines kept), so every offset outside it stays the same.
+"""
+from __future__ import annotations
+import re
+from .code_blocks import mask_blocks
+
+INLINE_TOKEN = re.compile(r"\\[\s\S]|`+")
+BLANK_LINE = re.compile(r"\n[ \t\r]*\n")
+
+def _blank(text: str, start: int, end: int) -> str:
+    return text[:start] + re.sub(r"[^\n]", " ", text[start:end]) + text[end:]
+
+def _inline_close(md: str, opening: re.Match) -> re.Match | None:
+    if opening.group(0).startswith("\\"): return None
+    limit = BLANK_LINE.search(md, opening.end())
+    return re.compile(rf"(?<!`){opening.group(0)}(?!`)").search(md, opening.end(), limit.start() if limit else len(md))
+
+def _mask_inline(md: str) -> str:
+    pos = 0
+    while opening := INLINE_TOKEN.search(md, pos):
+        close = _inline_close(md, opening)
+        pos = close.end() if close else opening.end()
+        if close: md = _blank(md, opening.start(), pos)
+    return md
+
+def mask_code(markdown: str) -> str:
+    """Return markdown with fenced, indented and inline code replaced by spaces."""
+    return _mask_inline(mask_blocks(markdown))
