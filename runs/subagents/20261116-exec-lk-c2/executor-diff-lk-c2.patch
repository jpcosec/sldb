+"""Find the lines of fenced and indented code blocks of a Markdown text (CommonMark).
+
+One pass over the lines keeps the stack of content columns of the open list items. A fence
+opens 0-3 columns past the content of its container, also on the line of a list marker
+(`- ```` or `1. ```python`), and closes with a line of the same character at least as long,
+0-3 columns past that same column; a non-blank line left of that column ends the item and
+the fence with it. Unclosed outside a list, a fence runs to the end. A line 4 columns past
+the content of its container after a blank line is indented code. Tabs count to the next
+multiple of 4 and `\\r\\n` counts like `\\n`.
+"""
+from __future__ import annotations
+import re
+
+FENCE = re.compile(r"(`{3,}(?=[^`]*$)|~{3,})")
+LIST_ITEM = re.compile(r" *([-*+]|\d{1,9}[.)])( +|$)")
+THEMATIC_BREAK = re.compile(r" {0,3}([-*_])( *\1){2,} *$")
+
+def _indent(text: str) -> int:
+    return len(text) - len(text.lstrip(" "))
+
+def _close_items(cols: list[int], indent: int) -> None:
+    while cols and indent < cols[-1]: cols.pop()
+
+def _in_fence(text: str, st: dict) -> bool | None:
+    """True for a line of the open fence (its closing line too); None once its list item ended."""
+    char, size, col = st["fence"]
+    indent = _indent(text)
+    if text.strip() and indent < col:
+        st["fence"], st["prev"] = None, "blank"
+        _close_items(st["cols"], indent)
+        return None
+    if indent - col <= 3 and re.fullmatch(rf"{re.escape(char)}{{{size},}}", text.strip()):
+        st["fence"], st["prev"] = None, "blank"
+    return True
+
+def _open_items(text: str, cols: list[int], base: int) -> tuple[int, int]:
+    """Open the list items whose markers start the line; return its content column and container column."""
+    pos, ref = 0, base
+    while not THEMATIC_BREAK.match(text) and (item := LIST_ITEM.match(text, pos)) and item.start(1) < ref + 4:
+        gap = len(item.group(2))
+        _close_items(cols, item.start(1))
+        ref = pos = item.end(1) + (gap if 1 <= gap <= 4 else 1)
+        cols.append(ref)
+    return (pos, ref) if pos else (_indent(text), base)
+
+def _open_fence(text: str, st: dict, start: int, ref: int) -> bool:
+    fence = FENCE.match(text, start)
+    if not fence or start - ref >= 4: return False
+    _close_items(st["cols"], start)
+    st["fence"] = (fence.group(1)[0], len(fence.group(1)), st["cols"][-1] if st["cols"] else 0)
+    return True
+
+def _outside(text: str, st: dict) -> bool:
+    cols, indent, after_blank = st["cols"], _indent(text), st["prev"] != "text"
+    if not text.strip():
+        st["prev"] = "blank"
+        return False
+    if after_blank: _close_items(cols, indent)
+    base = cols[-1] if cols else 0
+    st["prev"] = "code" if after_blank and indent >= base + 4 else "text"
+    return st["prev"] == "code" or _open_fence(text, st, *_open_items(text, cols, base))
+
+def _is_code(line: str, st: dict) -> bool:
+    text = line.rstrip("\r").expandtabs(4)
+    if st["fence"] and (code := _in_fence(text, st)) is not None: return code
+    return _outside(text, st)
+
+def mask_blocks(markdown: str) -> str:
+    """Return markdown with every line of a fenced or indented code block replaced by spaces."""
+    st = {"cols": [], "prev": "blank", "fence": None}
+    return "\n".join(" " * len(line) if _is_code(line, st) else line for line in markdown.split("\n"))
