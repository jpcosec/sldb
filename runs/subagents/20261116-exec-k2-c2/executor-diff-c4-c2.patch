+    assert facts["k.t.tp"]["relations"] == [{"type": "contained-in", "target": "k.t"}] and facts["k.t.tp"]["attrs"]["columns"] == ["a", "b"]
+    assert (facts["k.t.a"]["attrs"].get("unique"), "primary_key" in facts["k.t.c"]["attrs"]) == (True, False), "a quoted literal is no key"
