+++ b/src/sldb/code/sql_key_text.py
@@ -0,0 +1,53 @@
+"""Keys read from the text of an `ERROR` node, where tree-sitter-sql 0.3.13 gives no tree for them.
+
+Three shapes, matched case-insensitively and with quoted identifiers that keep `""` and any `)` or
+`,` inside (`"a""b"` is `a"b`): a whole key, `[CONSTRAINT name] {PRIMARY KEY|FOREIGN KEY|UNIQUE}
+(cols) [REFERENCES table [(cols)]]` (Django's `CONSTRAINT "x" UNIQUE (...)` inside `CREATE TABLE`);
+the `REFERENCES table [(cols)]` the grammar leaves after a foreign key or a column when it lists no
+referenced columns; and a `CONSTRAINT name` at the end of an `ERROR`, which names the key after it.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+from sldb.code.sql_names import unquote
+
+_ID = r'"(?:[^"]|"")*"|[\w$]+'
+_QNAME = rf"(?:{_ID})(?:\s*\.\s*(?:{_ID}))*"
+_LIST = r'(?:"(?:[^"]|"")*"|[^)"])*'
+_REFS = rf"REFERENCES\s+(?P<ref>{_QNAME})(?:\s*\((?P<refcols>{_LIST})\))?"
+_KEY = re.compile(rf"^\s*,?\s*(?:CONSTRAINT\s+(?P<name>{_ID})\s+)?(?P<type>PRIMARY\s+KEY|FOREIGN\s+KEY|UNIQUE)\s*\((?P<cols>{_LIST})\)(?:\s*{_REFS})?", re.I)
+_REF = re.compile(rf"^\s*{_REFS}", re.I)
+_TAIL = re.compile(rf"\bCONSTRAINT\s+(?P<name>{_ID})\s*$", re.I)
+TYPES = {"primary": ("primary_key", "pk"), "foreign": ("foreign_key", "fk"), "unique": ("unique", "unique")}
+
+
+def text_key(raw: str) -> dict[str, Any] | None:
+    """`{name, constraint_type, columns[, references]}` (`name` None when unnamed), or None."""
+    m = _KEY.match(raw)
+    if m is None:
+        return None
+    ctype = TYPES[m["type"].split()[0].lower()][0]
+    key = {"name": unquote(m["name"]) if m["name"] else None, "constraint_type": ctype, "columns": _cols(m["cols"])}
+    return {**key, "references": _refs(m)} if ctype == "foreign_key" and m["ref"] else key
+
+
+def text_refs(raw: str) -> dict[str, Any] | None:
+    """`{table, columns}` of a `REFERENCES` at the start of `raw`; `columns: []` is the referenced primary key."""
+    m = _REF.match(raw)
+    return _refs(m) if m is not None else None
+
+
+def tail_name(raw: str) -> str | None:
+    m = _TAIL.search(raw)
+    return unquote(m["name"]) if m is not None else None
+
+
+def _refs(m: re.Match[str]) -> dict[str, Any]:
+    return {"table": unquote(m["ref"]), "columns": _cols(m["refcols"] or "")}
+
+
+def _cols(raw: str) -> list[str]:
+    return [unquote(c) for c in re.findall(_ID, raw)]
diff --git a/src/sldb/code/sql_keys.py b/src/sldb/code/sql_keys.py
new file mode 100644
index 00000000..4a8a27d9
--- /dev/null
+++ b/src/sldb/code/sql_keys.py
@@ -0,0 +1,97 @@
+"""The keys of a table (`constraint` facts): `PRIMARY KEY`, `FOREIGN KEY` and `UNIQUE`, read from the tree.
+
+Where they are: each `constraint` of a `CREATE TABLE`'s `constraints`, each `ERROR` among its column
+definitions, and each `add_constraint` of an `ALTER TABLE` that names it (`ALTER TABLE t ADD
+CONSTRAINT name ...`, as `sqlmigrate` writes the FKs and `unique_together`). Where the grammar gives
+the key, its type, name (after `CONSTRAINT`), column list and `REFERENCES` table and list come from
+its nodes (`sql_names`). Only `ERROR` nodes are read as text (`sql_key_text`): a whole key the
+grammar did not parse (Django's `CONSTRAINT "x" UNIQUE (...)`); the `REFERENCES table` without
+columns that tree-sitter-sql 0.3.13 leaves in the `ERROR` after a foreign key (of `CREATE TABLE`, also
+after its `constraints`, or the last `ADD CONSTRAINT` of an `ALTER TABLE`) or after a column; and a `CONSTRAINT name` that ends
+the `ERROR` before a key. A foreign key without referenced columns gives `references.columns: []`,
+the referenced table's primary key, as in Postgres. No fact for a `CHECK`, an `EXCLUDE`, `ALTER TABLE
+t ADD PRIMARY KEY (...)` without a name, or a key the grammar buried inside another `ERROR`. An
+unnamed key is named by its type: `pk`, `fk`, `unique`.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from sldb.code.readers import text
+from sldb.code.sql_key_text import TYPES, tail_name, text_key, text_refs
+from sldb.code.sql_names import groups, name_end, span_name, unquote
+
+_KW = {f"keyword_{word}": ctype for word, (ctype, _) in TYPES.items()}
+_SHORT = dict(TYPES.values())
+_CLIMB = ("constraints", "constraint", "add_constraint", "alter_table", "statement")
+
+
+def table_keys(create: Any) -> list[Any]:
+    """The nodes of a `CREATE TABLE` that may hold a key, in order."""
+    defs = next((c for c in create.named_children if c.type == "column_definitions"), None)
+    kids = defs.named_children if defs is not None else []
+    return [c for k in kids for c in (k.named_children if k.type == "constraints" else [k]) if c.type in ("constraint", "ERROR")]
+
+
+def alter_keys(alter: Any) -> list[Any]:
+    return [c for c in alter.named_children if c.type == "add_constraint"]
+
+
+def read_key(node: Any, src: bytes, named: bool) -> dict[str, Any] | None:
+    """`{name, named, constraint_type, columns[, references]}`, or None; `named` asks for `CONSTRAINT name`."""
+    key = text_key(text(node, src)) if node.type == "ERROR" else _tree_key(node, src)
+    if key is None or (named and key["name"] is None):
+        return None
+    if key["constraint_type"] == "foreign_key" and "references" not in key:
+        key.update({"references": refs} if (refs := text_refs(_after(node, src))) else {})
+    return {**key, "name": key["name"] or _SHORT[key["constraint_type"]], "named": key["name"] is not None}
+
+
+def references(owner: Any, src: bytes) -> dict[str, Any] | None:
+    """`{table, columns}` of the `REFERENCES` of a constraint or a column: from its nodes, or the `ERROR` after it."""
+    kids = owner.children
+    at = next((i for i, c in enumerate(kids[:-1]) if c.type == "keyword_references" and kids[i + 1].type == "object_reference"), None)
+    if at is None:
+        return text_refs(_after(owner, src))
+    ref, end = kids[at + 1], name_end(kids[at + 1], src)
+    rest = [c for c in kids[at + 2:] if c.start_byte >= end]
+    cols = rest[:next(i for i, c in enumerate(rest + [None]) if c is None or c.type == ")")] if rest and rest[0].type == "(" else []
+    return {"table": unquote(src[ref.start_byte:end].decode("utf-8", "replace")), "columns": groups(cols, src)}
+
+
+def key_name_node(node: Any, key_named: bool) -> Any:
+    """The node of the constraint's name (the first identifier or literal), or the node's first child if it has none."""
+    return next((c for c in node.children if c.type in ("identifier", "literal")), node.children[0]) if key_named else node.children[0]
+
+
+def _tree_key(node: Any, src: bytes) -> dict[str, Any] | None:
+    cons = node if node.type == "constraint" else next((c for c in node.named_children if c.type == "constraint"), None)
+    kw = next((c for c in cons.children if c.type in _KW), None) if cons is not None else None
+    if kw is None:
+        return None
+    cols = next((c.children for c in cons.children if c.type == "ordered_columns"), [])
+    key = {"name": _tree_name(node, cons, kw, src), "constraint_type": _KW[kw.type], "columns": groups(cols, src)}
+    refs = references(cons, src) if key["constraint_type"] == "foreign_key" else None
+    return {**key, "references": refs} if refs else key
+
+
+def _tree_name(node: Any, cons: Any, kw: Any, src: bytes) -> str | None:
+    """The nodes between `CONSTRAINT` and the key (`ADD CONSTRAINT name`, `CONSTRAINT name PRIMARY KEY`), or the name ending the `ERROR` before."""
+    kids = (node if node.type == "add_constraint" else cons).children
+    at = next((i for i, c in enumerate(kids) if c.type == "keyword_constraint"), None)
+    if at is not None:
+        stop = cons if node.type == "add_constraint" else kw
+        return span_name([c for c in kids[at + 1:] if c.end_byte <= stop.start_byte], src)
+    prev = node.prev_sibling
+    return tail_name(text(prev, src)) if prev is not None and prev.type == "ERROR" else None
+
+
+def _after(node: Any, src: bytes) -> str:
+    """The text of the `ERROR` nodes right after `node`, or after its `constraints` or `ALTER TABLE` statement when it ends them."""
+    while node.next_sibling is None and node.parent is not None and node.parent.type in _CLIMB:
+        node = node.parent
+    sib, start, end = node.next_sibling, None, 0
+    while sib is not None and sib.type == "ERROR":
+        start, end, sib = sib.start_byte if start is None else start, sib.end_byte, sib.next_sibling
+    return src[start:end].decode("utf-8", "replace") if start is not None else ""
