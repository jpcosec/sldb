--- /dev/null
+++ b/src/sldb/code/sql_fact.py
@@ -0,0 +1,47 @@
+"""The fact of one SQL object (table, view, index, column or constraint), and the `references` relations.
+
+A `constraint` fact hangs from its table (`contained-in`): the table's fact for the keys of a
+`CREATE TABLE`; for an `ALTER TABLE ... ADD CONSTRAINT`, the first table of that name read before it
+in the file, or the module when there is none. Its qualified name is `<table>.<constraint name>`
+(`<table>.pk`, `<table>.fk`, `<table>.unique` when unnamed), suffixed `~2`, `~3` by `Ids` in source
+order. `attrs` carry `constraint_type` (`primary_key`, `foreign_key`, `unique`), `columns` and, for a
+foreign key, `references` `{table, columns}`; the relation `references` to the referenced table's
+fact is added only when that table has a fact in the same file, before or after the key; the same
+for a column with a `REFERENCES` of its own (`attrs.references`, no `constraint` fact).
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from sldb.code.facts import fact, rels
+from sldb.code.sql_fingerprints import sql_fingerprints
+from sldb.code.sql_keys import key_name_node, read_key
+from sldb.code.sql_readers import sql_name, sql_norm
+
+
+def sql_fact(node: Any, name: Any, kind: str, qualified: str, doc: str | None, owner: str, ctx: dict[str, Any]) -> dict[str, Any]:
+    module, src = ctx["module"], ctx["src"]
+    return fact(id=ctx["ids"].take(f"{module}.{qualified}" if module else qualified), kind=kind, name=sql_name(name, src).rsplit(".", 1)[-1], qualified_name=qualified,
+                path=ctx["rel"], span={"start_line": node.start_point[0] + 1, "end_line": node.end_point[0] + 1}, source_hash=ctx["digest"],
+                signature=sql_norm(node, src), doc=doc, relations=rels(owner), attrs={"native_kind": node.type, "module": module},
+                fingerprints=sql_fingerprints(node, name, doc, src))
+
+
+def key_facts(nodes: list[Any], table: str, owner: str, ctx: dict[str, Any], named: bool) -> list[dict[str, Any]]:
+    """One `constraint` fact per node that reads as a key; `named` keeps only `CONSTRAINT name` (the `ALTER TABLE` case)."""
+    out = []
+    for node, key in ((n, read_key(n, ctx["src"], named)) for n in nodes):
+        if key is not None:
+            name, named_node = key.pop("name"), key_name_node(node, key.pop("named"))
+            out.append(sql_fact(node, named_node, "constraint", ctx["local"].take(f"{table}.{name}"), None, owner, ctx))
+            out[-1]["name"], out[-1]["attrs"] = name, {**out[-1]["attrs"], **key}
+    return out
+
+
+def link_references(facts: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Adds `references` from a key or a column to the referenced table's fact (the first of that qualified name in the file), if any."""
+    tables = {f["qualified_name"]: f["id"] for f in reversed(facts) if f["kind"] == "table"}
+    for f in (f for f in facts if f["kind"] in ("constraint", "column") and f["attrs"].get("references", {}).get("table") in tables):
+        f["relations"] = sorted(f["relations"] + [{"type": "references", "target": tables[f["attrs"]["references"]["table"]]}], key=lambda r: (r["type"], r["target"]))
+    return facts
