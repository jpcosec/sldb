index 00000000..c7c335f2
--- /dev/null
+++ b/src/sldb/code/sql_names.py
@@ -0,0 +1,42 @@
+"""SQL identifiers as the tree delimits them: quotes off, `""` as `"`, the parts joined by dots.
+
+A name is read from the bytes of tree-sitter nodes: one node (`sql_name` in `sql_readers`) or a run
+of sibling nodes between two tokens the grammar gives (`span_name`, `groups`). tree-sitter-sql
+0.3.13 splits a quoted identifier with an escaped quote (`"a""b"`) into `"a"` and a second token,
+often an `ERROR`; a run already covers both, and a single name node (a table, a column) runs on
+over the quoted parts glued to its closing quote (`name_end`): `"a""b"."c""d"` is `a"b.c"d`.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+_PART = re.compile(r'"((?:[^"]|"")*)"|([^".\s]+)')
+_GLUED = re.compile(rb'"(?:[^"]|"")*"|\s*\.\s*(?:"(?:[^"]|"")*"|[\w$]+)')
+
+
+def unquote(raw: str) -> str:
+    """`"public"."users"` is `public.users`, `"a""b"` is `a"b`."""
+    return ".".join(bare or quoted.replace('""', '"') for quoted, bare in _PART.findall(raw))
+
+
+def name_end(node: Any, src: bytes) -> int:
+    """Where the identifier that starts at `node` ends: past the quoted parts the grammar split from it."""
+    end = node.end_byte
+    while src[end - 1:end] == b'"' and (m := _GLUED.match(src, end)) is not None:
+        end = m.end()
+    return end
+
+
+def span_name(nodes: list[Any], src: bytes) -> str | None:
+    """The name written from the first to the last of `nodes`, or None when there are none."""
+    return unquote(src[nodes[0].start_byte:nodes[-1].end_byte].decode("utf-8", "replace")) if nodes else None
+
+
+def groups(nodes: list[Any], src: bytes) -> list[str]:
+    """The names of a parenthesized list's children, split at the `,` tokens (`(`, `)` left out)."""
+    runs: list[list[Any]] = [[]]
+    for node in (n for n in nodes if n.type not in ("(", ")")):
+        runs[-1:] = [runs[-1], []] if node.type == "," else [runs[-1] + [node]]
+    return [name for name in (span_name(run, src) for run in runs) if name]
