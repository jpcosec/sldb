+"""What a column says about itself: its type and its key marks (`attrs` of a `column` fact).
+
+`type` is the text between the name and the first constraint keyword (`NOT`, `NULL`, `DEFAULT`,
+`PRIMARY`, `GENERATED`, `REFERENCES`, `UNIQUE`, `CHECK`) or the first `ERROR` node, whitespace
+collapsed: `bigint`, `timestamp with time zone`. The marks are read case-insensitively from the
+text after the name, without `--` comments, single-quoted literals and double-quoted identifiers:
+`primary_key` (`PRIMARY KEY`), `unique` (`UNIQUE`) and `identity` (`GENERATED ... AS IDENTITY`),
+each present only when true. A key written in the column gives a mark, never a `constraint` fact.
+`parse_partial` is true when the `column_definition` has a parse error (Django's `id ... GENERATED
+BY DEFAULT AS IDENTITY` in tree-sitter-sql 0.3.13) and the column is read anyway. The name runs on
+over the quoted parts the grammar split from it (`"a""b" int` is `a"b`, of type `int`: an `ERROR`
+right after the name does not end the type). A `REFERENCES table [(cols)]` written in the column
+gives `references` `{table, columns}` (`columns: []` is the referenced primary key), never a fact.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+from sldb.code.sql_keys import references
+from sldb.code.sql_names import name_end
+
+_STOP = {f"keyword_{k}" for k in ("not", "null", "default", "primary", "generated", "references", "unique", "check")} | {"ERROR"}
+_NOISE = re.compile(r"--[^\n]*|'(?:[^']|'')*'|\"(?:[^\"]|\"\")*\"")
+_MARKS = {"primary_key": re.compile(r"\bprimary\s+key\b", re.I), "unique": re.compile(r"\bunique\b", re.I),
+          "identity": re.compile(r"\bgenerated\s+(?:always|by\s+default)\s+as\s+identity\b", re.I)}
+
+
+def column_name(col: Any) -> Any:
+    """The `name` node of a `column_definition` when it is its first child and reads cleanly, even if the definition has an error."""
+    name = col.child_by_field_name("name")
+    return name if name is not None and not name.has_error and col.children[0] == name else None
+
+
+def column_attrs(col: Any, name: Any, src: bytes) -> dict[str, Any]:
+    start = name_end(name, src)
+    after, kids = src[start:col.end_byte].decode("utf-8", "replace"), [c for c in col.children if c.start_byte >= start]
+    stop = next((c.start_byte for i, c in enumerate(kids) if c.type in _STOP and (i or c.type != "ERROR")), col.end_byte)
+    attrs: dict[str, Any] = {"type": " ".join(src[start:stop].decode("utf-8", "replace").split()) or None}
+    attrs.update({mark: True for mark, rx in _MARKS.items() if rx.search(_NOISE.sub(" ", after))})
+    attrs.update({"references": refs} if (refs := references(col, src)) else {})
+    return {**attrs, "parse_partial": True} if col.has_error else attrs
