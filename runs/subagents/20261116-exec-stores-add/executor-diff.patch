+def _other_store(tmp_path: Path, name: str = "other") -> Path:
+    other = tmp_path / name
+    other.mkdir(parents=True)
+    assert cli_main(["stores", "init", "--path", str(other)]) == 0
+    return other / ".sldb"
+
+
+def _add_link(api_store, path: str, name: str = "shared") -> str:
+    assert cli_main(["stores", "add", path, "--name", name, "--store", str(api_store.store)]) == 0
+    return next(s.path for s in load_store_index(api_store.store).stores if s.name == name)
+
+
+def test_stores_add_keeps_an_absolute_path_absolute(api_store, tmp_path):
+    from sldb.store.query import _linked_stores
+
+    other = _other_store(tmp_path)
+    assert _add_link(api_store, str(other)) == str(other)
+    assert _linked_stores(api_store.store.resolve()) == [(other.resolve(), "shared")]
+
+
+def test_stores_add_keeps_a_home_path_as_written_and_reads_it_with_home(api_store, tmp_path, monkeypatch):
+    from sldb.store.query import _linked_stores
+
+    home = tmp_path / "home"
+    other = _other_store(home, "other")
+    monkeypatch.setenv("HOME", str(home))
+    assert _add_link(api_store, "~/other/.sldb") == "~/other/.sldb"
+    assert _linked_stores(api_store.store.resolve()) == [(other.resolve(), "shared")]
+
+
+def test_stores_add_keeps_a_variable_path_as_written_and_reads_it_with_the_variable(api_store, tmp_path, monkeypatch):
+    from sldb.store.query import _linked_stores
+
+    other = _other_store(tmp_path / "vroot", "other")
+    monkeypatch.setenv("SLDB_TEST_ROOT", str(tmp_path / "vroot"))
+    assert _add_link(api_store, "$SLDB_TEST_ROOT/other/.sldb") == "$SLDB_TEST_ROOT/other/.sldb"
+    assert _linked_stores(api_store.store.resolve()) == [(other.resolve(), "shared")]
+    assert _add_link(api_store, "${SLDB_TEST_ROOT}/other/.sldb", "braced") == "${SLDB_TEST_ROOT}/other/.sldb"
+    assert cli_main(["stores", "remove", "braced", "--store", str(api_store.store)]) == 0
+    assert cli_main(["stores", "add", "$SLDB_TEST_ROOT/other/.sldb", "--name", "shared", "--replace", "--store", str(api_store.store)]) == 0
+    assert [s.name for s in load_store_index(api_store.store).stores] == ["shared"]
+
+
+def test_stores_add_keeps_a_relative_path_relative_to_the_root(api_store, tmp_path, monkeypatch):
+    from sldb.store.query import _linked_stores
+
+    other = _other_store(tmp_path)
+    monkeypatch.chdir(tmp_path)
+    assert _add_link(api_store, "other/.sldb") == "../other/.sldb"
+    assert _linked_stores(api_store.store.resolve()) == [(other.resolve(), "shared")]
+
