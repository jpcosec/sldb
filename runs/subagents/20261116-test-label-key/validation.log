### caso extra: /dev/shm/tlk/edge.py (paridad con normKey en node + E2E collect_explicit_atoms)
import json, subprocess, string, itertools
from sldb.api.matching.atom_keys import label_key, normalize_key
from sldb.api.matching.spec_view import SpecView
from sldb.api.matching.spec_view_elements import collect_explicit_atoms
from sldb.api.notations.spec_sync_constants import _ELEMENT_COLLECTIONS
JS = "const normKey=s=>String(s||'').trim().toLowerCase().replace(/[^\\p{L}\\p{N}\\s]+/gu,' ').replace(/\\s+/g,' ').trim();" \
     "const a=JSON.parse(require('fs').readFileSync(0,'utf8'));console.log(JSON.stringify(a.map(normKey)));"
pr = [c for c in string.printable if c not in "\x0b\x0c"]
cases = [f"a{c}b" for c in pr] + [f"{c}{c}x{c}" for c in pr] + [
  "post_published","Año_2024","a-b_c.d","  x__y  ","_lead_","__","_","Ñandú_42 ok","x_1_y","snake_case_ID","ÉLAN_vital","a\t_\nb","Straße_ß","٣_x","x²_y", ""]
js = json.loads(subprocess.run(["node","-e",JS],input=json.dumps(cases),capture_output=True,text=True,check=True).stdout)
bad = [(c, label_key(c), j) for c, j in zip(cases, js) if label_key(c) != j]
print("casos", len(cases), "diferencias", len(bad))
for b in bad: print("  DIFF", repr(b[0]), repr(b[1]), "js=", repr(b[2]))
# negativos: normalize_key intacto (sigue conservando _ ?)
print("normalize_key('post_published') =", repr(normalize_key("post_published")))
# extremo a extremo: elemento sin label con id con _
typ, cols = next(iter(_ELEMENT_COLLECTIONS.items()))
spec = {"type": typ, "data": {cols[0]: {"post_published": {"atoms": ["atom-x"]}, "Otro_Id": {"label": "Mi_Label", "atoms": ["atom-y"]}}}}
explicit, total, wa = collect_explicit_atoms(SpecView(key="k", id="v", specs=[spec]))
print("tipo", typ, cols[0], "->", explicit, total, wa)
assert explicit.get("post published") == ["atom-x"] and "post_published" not in explicit
assert explicit.get("mi label") == ["atom-y"] and explicit.get("otro id") == ["atom-y"]
print("E2E OK")
