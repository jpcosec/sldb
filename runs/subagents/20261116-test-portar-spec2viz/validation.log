"""Bordes no cubiertos por el ejecutor (tester deskops-t-ba1b1f54d370)."""
import shutil, sys
from pathlib import Path
import pytest
import sldb.api as sldb_api
from sldb.api.notations import SpecSync, sync_catalog, resolve_view

FIX = Path("/mnt/ssd/proyectos/SLDB_1/sldb/tests/notations/fixtures")

def _proj(tmp_path):
    shutil.copytree(FIX / "docs", tmp_path / "docs")
    sldb_api.init_store(tmp_path)
    return tmp_path / ".sldb", tmp_path / "docs/architecture/vistas.yml"

def test_skip_catalog_hides_no_spec(tmp_path):
    # el `continue` de los informes "catalog " no debe tragarse specs: 11 specs en vistas.yml -> 11 informes de spec
    store, cfg = _proj(tmp_path)
    reports = sync_catalog(SpecSync(store), cfg)
    cat = [r for r in reports if r.spec_id.startswith("catalog ")]
    specs = [r for r in reports if not r.spec_id.startswith("catalog ")]
    print("catalog reports:", [r.spec_id for r in cat])
    assert len(cat) <= 1
    assert len(specs) == 11, [r.spec_id for r in specs]
    assert len({r.spec_id for r in specs}) == 11
    for r in specs:
        assert resolve_view(store, r.spec_id)["skipped"] == []

def test_missing_spec_in_catalog_is_an_error(tmp_path):
    # negativo: si falta un spec referido por vistas.yml, el sync no lo salta en silencio
    store, cfg = _proj(tmp_path)
    (tmp_path / "docs/architecture/spec2viz/class-sldb-models.yml").unlink()
    try:
        reports = sync_catalog(SpecSync(store), cfg)
    except Exception as exc:  # error esperado
        print("raised:", type(exc).__name__, exc)
        return
    ids = [r.spec_id for r in reports if not r.spec_id.startswith("catalog ")]
    pytest.fail(f"sync_catalog no fallo con un spec ausente; informes: {ids}")

def test_no_spec2viz_importable():
    with pytest.raises(ModuleNotFoundError):
        __import__("spec2viz")
