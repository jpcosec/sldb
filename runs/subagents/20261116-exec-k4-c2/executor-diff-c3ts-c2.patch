diff --git a/src/sldb/code/ts_callee.py b/src/sldb/code/ts_callee.py
new file mode 100644
index 00000000..3b4d069d
--- /dev/null
+++ b/src/sldb/code/ts_callee.py
@@ -0,0 +1,61 @@
+"""The canonical name of a called TypeScript/JavaScript expression, built from the tree, not the text:
+identifiers and property names joined by `.` (`?.` and `!` when written), with no whitespace, no
+`await` and no type arguments (`client\\n  .documents` gives `client.documents`). A link of the chain
+that is itself a call is written `()` without its arguments (`fetch(url).then(cb).then` gives
+`fetch().then().then`; `(await listDocuments(m)).slice` gives `listDocuments().slice`); a `new X()`
+link is written like a call, `X()`. An anonymous function or IIFE as object is `(fn)`; an index
+access is `[]` (`?.[]` when optional). Parentheses, `await`, `as`/`satisfies` and `x<T>` are seen
+through. Any other expression (a literal) is its text without whitespace.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from sldb.code.readers import text
+
+_LEAVES = {"identifier", "property_identifier", "private_property_identifier", "this", "super"}
+_FUNCTIONS = {"arrow_function", "function_expression", "function", "generator_function"}
+_SEEN_THROUGH = {"await_expression", "parenthesized_expression", "as_expression", "satisfies_expression", "instantiation_expression"}
+
+
+def call_name(node: Any, src: bytes) -> str:
+    """The canonical name of `node` (the `function` field of a call, or a link of its chain)."""
+    kind = node.type
+    if kind in _LEAVES:
+        return text(node, src)
+    if kind in _FUNCTIONS:
+        return "(fn)"
+    if kind in _SEEN_THROUGH and node.named_child_count:
+        return call_name(node.named_children[0], src)
+    build = _BUILDERS.get(kind)
+    return build(node, src) if build is not None else "".join(text(node, src).split())
+
+
+def _optional(node: Any) -> bool:
+    return any(c.type == "optional_chain" for c in node.children)
+
+
+def _member(node: Any, src: bytes) -> str:
+    dot = "?." if _optional(node) else "."
+    return call_name(node.child_by_field_name("object"), src) + dot + text(node.child_by_field_name("property"), src)
+
+
+def _subscript(node: Any, src: bytes) -> str:
+    return call_name(node.child_by_field_name("object"), src) + ("?.[]" if _optional(node) else "[]")
+
+
+def _call(node: Any, src: bytes) -> str:
+    return call_name(node.child_by_field_name("function"), src) + "()"
+
+
+def _new(node: Any, src: bytes) -> str:
+    return call_name(node.child_by_field_name("constructor"), src) + "()"
+
+
+def _non_null(node: Any, src: bytes) -> str:
+    return call_name(node.named_children[0], src) + "!"
+
+
+_BUILDERS = {"member_expression": _member, "subscript_expression": _subscript, "call_expression": _call,
+             "new_expression": _new, "non_null_expression": _non_null}
diff --git a/src/sldb/code/ts_calls.py b/src/sldb/code/ts_calls.py
new file mode 100644
index 00000000..b2448357
--- /dev/null
+++ b/src/sldb/code/ts_calls.py
@@ -0,0 +1,51 @@
+"""Calls in TypeScript/JavaScript source as text, with no type or import resolved, in the form of
+Python's (`py_calls`): the calls a function, hook or component makes (`fetch`, `axios.get`,
+`api.posts.create`), one `{name, line, first_arg}` per call in source order. `name` is the whole
+called expression, unsplit, in the canonical form of `ts_callee` (built from the tree: no whitespace,
+no `await`, no type arguments, `()` for a call in the chain, `(fn)`, `[]`); `first_arg` is a first
+argument that is a string or a template without `${...}`, without its quotes or backticks (escapes
+as written), else None. Like a
+nested `def` in Python, a nested `function`, generator or `class` declaration is not walked; an
+arrow function or function expression is (a callback, an inline handler), like a `lambda`. `new X()`
+is not a call.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from sldb.code.readers import first_statement, text
+from sldb.code.ts_callee import call_name
+
+_NESTED = {"function_declaration", "generator_function_declaration", "class_declaration", "class"}
+_LITERALS = {"string", "template_string"}
+
+
+def body_nodes(fn: Any) -> list[Any]:
+    """The nodes of a function's body in source order (pre-order), without entering a nested declaration."""
+    out, stack = [], [fn.child_by_field_name("body")]
+    while stack:
+        n = stack.pop()
+        if n is None or n.type in _NESTED:
+            continue
+        out.append(n)
+        stack.extend(reversed(n.named_children))
+    return out
+
+
+def callee(call: Any, src: bytes) -> str:
+    """The canonical name of the `function` field (`ts_callee`); the grammar reads `await f<T>(...)` as
+    a call whose function is `await f`, and `call_name` sees through that `await`."""
+    return call_name(call.child_by_field_name("function"), src)
+
+
+def first_arg(call: Any, src: bytes) -> str | None:
+    args = call.child_by_field_name("arguments")
+    lit = first_statement(args) if args is not None and args.type == "arguments" else args
+    if lit is None or lit.type not in _LITERALS or any(c.type == "template_substitution" for c in lit.named_children):
+        return None
+    return text(lit, src)[1:-1]
+
+
+def body_calls(nodes: list[Any], src: bytes) -> list[dict[str, Any]]:
+    return [{"name": callee(n, src), "line": n.start_point[0] + 1, "first_arg": first_arg(n, src)} for n in nodes if n.type == "call_expression"]
diff --git a/src/sldb/code/ts_jsx.py b/src/sldb/code/ts_jsx.py
new file mode 100644
index 00000000..a0847a86
--- /dev/null
+++ b/src/sldb/code/ts_jsx.py
@@ -0,0 +1,47 @@
+"""The JSX attributes of a component that bind an event to a handler, without knowing any framework:
+an attribute whose name is `on` followed by an uppercase letter (`onClick`, not `only`) and whose
+value is `{identifier}` (`onClick={handleSave}` gives `handleSave`), `{call(...)}` or a function whose
+body is a call (`{() => save(x)}`, `{() => { save(x); }}`), which give the called expression (`save`). Anything else (a member
+expression, a string, a spread) is not a handler. `element` is the tag's name as written
+(`button`, `Button`, `Form.Item`).
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from sldb.code.readers import field_text, first_statement, text
+from sldb.code.ts_calls import callee
+
+_FUNCTIONS = {"arrow_function", "function_expression", "function"}
+
+
+def jsx_handlers(nodes: list[Any], src: bytes) -> list[dict[str, str]]:
+    """`{element, attribute, handler}` of each handler attribute among `nodes`, in source order."""
+    out = []
+    for n in nodes:
+        name = text(n.named_children[0], src) if n.type == "jsx_attribute" else ""
+        handler = _handler(n.named_children[-1], src) if _is_event(name) and n.named_child_count == 2 else None
+        if handler is not None:
+            out.append({"element": field_text(n.parent, src, "name"), "attribute": name, "handler": handler})
+    return out
+
+
+def _is_event(name: str) -> bool:
+    return name.startswith("on") and name[2:3].isupper()
+
+
+def _handler(value: Any, src: bytes) -> str | None:
+    expr = first_statement(value) if value.type == "jsx_expression" else None
+    if expr is not None and expr.type in _FUNCTIONS:
+        expr = _inner_call(expr.child_by_field_name("body"))
+    if expr is None or expr.type not in ("identifier", "call_expression"):
+        return None
+    return text(expr, src) if expr.type == "identifier" else callee(expr, src)
+
+
+def _inner_call(body: Any) -> Any:
+    """A function body's call: the body itself, or a block whose first statement is a call."""
+    stmt = first_statement(body) if body is not None and body.type == "statement_block" else body
+    inner = first_statement(stmt) if stmt is not None and stmt.type == "expression_statement" else stmt
+    return inner if inner is not None and inner.type == "call_expression" else None
