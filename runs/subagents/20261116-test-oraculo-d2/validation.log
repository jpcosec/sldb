### Caso propio 1: regenerar golden desde spec2viz (PYTHONPATH=checkout) — /dev/shm/tester-oraculo/check.py
import ast, json, sys, tempfile, pathlib, subprocess
repo = pathlib.Path("/mnt/ssd/proyectos/SLDB_1/sldb")
test = repo / "tests/notations/test_component_spec_python.py"
golden_path = repo / "tests/notations/goldens/component_spec_python_spec2viz.json"
src = test.read_text()
TREE = next(ast.literal_eval(n.value) for n in ast.parse(src).body if isinstance(n, ast.Assign) and getattr(n.targets[0], "id", "") == "TREE")
from spec2viz.generators import python_ast
d = pathlib.Path(tempfile.mkdtemp(dir="/dev/shm"))
for rel, text in TREE.items():
    (d / rel).parent.mkdir(parents=True, exist_ok=True); (d / rel).write_text(text)
spec = python_ast.generate_python_ast_spec(d)
nodes = spec["data"]["nodes"]
pick = lambda k: {i: v["label"] for i, v in nodes.items() if v["kind"] == k}
mine = {"modules": pick("module"), "classes": pick("class"),
        "defines": sorted([e["from"], e["to"]] for e in spec["data"]["edges"] if e["relation"] == "defines"),
        "_source": subprocess.check_output(["git","-C","/mnt/ssd/proyectos/SLDB_1/spec2viz","rev-parse","HEAD"], text=True).strip()}
golden = json.loads(golden_path.read_text())
print("regenerated == golden:", mine == golden)
print("serialization sort_keys/indent=2 identical:", json.dumps(golden, sort_keys=True, indent=2) == golden_path.read_text().rstrip("\n"))
print("keys:", sorted(golden))
