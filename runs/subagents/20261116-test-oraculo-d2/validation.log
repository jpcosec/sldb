  out=$(cd $R && TMPDIR=/dev/shm uv run --frozen --extra code --extra dev pytest -q -p no:cacheprovider --rootdir=$W $W/test_component_spec_python.py -k matches_spec2viz 2>&1 | tail -2)
  echo "[$name] $out"; }
