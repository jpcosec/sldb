## caso extra del tester (/dev/shm/ci1t-clon/tests/api/test_ci1t_extra.py)
"""Bordes del tester: el camino inverso y el filtro de relaciones, sobre el mismo store en tmp."""
from sldb import api
from sldb.api.graph import graph_path
from tests.api.test_api_graph_analysis import MODULE, S1, _refines, world  # noqa: F401


def _card(world):
    api.add_model(world.store, f"{MODULE}:Card", world.py)
    world.create("Card", "c1", {"title": "C1", "about": "Spec:s3"})


def test_reverse_walk_keeps_field_and_reads_backward(world):
    _card(world)
    found = graph_path(world.store, S1, "sldb://document/Card:c1", relations=["references", "refines"], explain=True, include_linked=False)
    edges = [e for s in found["steps"] for e in s["edges"]]
    assert edges[-1]["provenance"] == {"origin": "schema", "field": "about"} and edges[-1]["direction"] == "backward"
    assert edges[:-1] == [_refines("s2-s1", "backward"), _refines("s3-s2", "backward")]


def test_without_references_relation_there_is_no_path(world):
    _card(world)
    assert graph_path(world.store, "sldb://document/Card:c1", S1, relations=["refines"], explain=True, include_linked=False) is None


def test_default_relations_do_not_walk_references(world):
    _card(world)
    print("DEFAULT:", graph_path(world.store, "sldb://document/Card:c1", S1, explain=True, include_linked=False))
