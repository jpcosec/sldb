' --- trazabilidad (diagram-traceability-contract) ---
' vista: d12
' governed-by: sldb.target.components, sldb.target.runtime
@startuml
title Ejecución segura de hooks

participant "Event Bus" as Events
participant "Hook Engine" as Hooks
participant "Logic Engine" as Logic
participant "Capability Manager" as Caps
database "Effect Outbox" as Outbox
participant "Effect Runner" as Runner
participant "Git / Tool / Agent" as Tool
participant "Transaction Engine" as Tx

Events -> Hooks : TransactionCommitted(event)
Hooks -> Hooks : buscar hooks aplicables
Hooks -> Logic : evaluar condición
Logic --> Hooks : true / false

alt condición verdadera
    Hooks -> Caps : validar ActionPlan
    Caps --> Hooks : permitido

    Hooks -> Outbox : enqueue(effect)
    Outbox --> Hooks : effect_id

    Runner -> Outbox : claim(effect)
    Runner -> Tool : ejecutar acción
    Tool --> Runner : resultado

    Runner -> Tx : registrar EffectResult
    Tx --> Runner : nueva revisión
else condición falsa
    Hooks -> Hooks : no action
end

@enduml
